<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ખાતાવહી</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        /* font-family: sans-serif; */
        background-color: #f5f7ff; /* Light blue background */
        color: #777777;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        font-weight: 400;
      }

      .gujarati-font {
        font-family: "Gujarati Font Name", serif;
      }

      .container {
        padding: 30px 30px;
      }

      .main-container {
        background-color: #fff;
        padding: 35px;
        border-radius: 5px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        /* margin-top: 20px; */
        margin-top: 0px;
      }

      .section-header {
        text-align: center;
        color: #111111;
        margin-bottom: 25px;
        font-weight: 600;
        font-size: 18px;
        line-height: 1.5em;
        border-top: 1px solid #eaeaea;
        border-bottom: 1px solid #eaeaea;
        padding: 10px 0;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        /* border-radius: 5px; Add border-radius for rounded corners */
        border: 1px solid #eaeaea;
        border-radius: 6px;
        /* overflow: hidden; */
        text-align: center;
      }

      th,
      td {
        border: 1px solid #ccc;
        padding: 5px;
        text-align: center; /* Ensure center alignment */
        vertical-align: middle; /* Align text vertically in the center */
      }

      th {
        background-color: #e6e6e6;
        font-weight: bold;
      }

      tr:nth-child(even) {
        background-color: #f9f9f9; /* Light gray row shading */
      }

      .merged-cell {
        background-color: #f0f0f0; /* Light gray for merged cells */
        font-weight: bold;
        /* padding: 15px; */
      }

      th.merged-table-th,
      td.merged-table-td {
        padding: 5px;
        color: #777777;
      }

      .info-section {
        display: flex;
      }

      .info-item {
        flex: 1;
        padding: 5px 25px;
      }
      .cs-f28 {
        font-size: 28px;
      }

      .cs-m0 {
        margin: 0px !important;
      }

      .cs-dip_blue_color {
        color: #2525cf;
      }

      .cs-bold {
        font-weight: 700;
      }

      .secondary-text {
        font-size: 15px;
        color: #777777;
        margin: 0px !important;
        line-height: 1.5em;
      }
      .text-header {
        text-align: center;
        margin-bottom: 25px;
      }
      .details-list {
        list-style: none;
        margin: 0 0 30px 0;
        padding: 12px 0;
        border: 1px solid #eaeaea;
        border-radius: 5px;
        background: #f6f6f6;
      }

      .cs-primary_color {
        color: #111111;
      }
      th.cs-primary_color {
        color: #111111;
      }
      td.cs-primary_color {
        color: #111111;
      }
      .cs-semi_bold {
        font-weight: 600;
      }
      th.cs-semi_bold {
        font-weight: 600;
      }
      td.cs-semi_bold {
        font-weight: 600;
      }

      th.tr-thead-credit {
        background-color: #c7f8bb;
      }
      th.tr-thead-debit {
        background-color: #f8a1a1;
      }
      th.tr-credit,
      td.tr-credit {
        background-color: #e3f3df;
      }
      th.tr-debit,
      td.tr-debit {
        background-color: #f2cdcd;
      }

      th.tr-bg-gray, td.tr-bg-gray {
          background-color: #f6f6f6;
      }

      table th,
      table td {
        border: 1px solid #eaeaea;
        border-collapse: collapse;
        text-align: center; /* Ensure center alignment */
        vertical-align: middle; /* Align text vertically in the center */
      }
      .container {
        max-width: 100% !important;
        width: 100%;
      }

      @media print {
        @page {
          size: A4 landscape;
          margin: 0; /* Remove margins */
        }

        body {
          background-color: #fff !important;
        }

        .main-container {
          width: 100%;
          padding: 20px; /* Adjust padding */
        }

        table {
          width: 100%;
        }

        th,
        td {
          font-size: 12px; /* Reduce font size if needed */
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="main-container">
        <div class="text-header">
          <h1
            class="text-center gujarati-font cs-f28 cs-m0 cs-bold cs-dip_blue_color text-transform-uppercase"
          >
            ખાતાવહી
          </h1>
          <p class="text-center secondary-text">
            <%= reportData?.userDetails?.rojmel_name %> (<%= reportData?.userDetails?.bank_account_no %> - <%= reportData?.userDetails?.bank_name %>)
          </p>
        </div>
        <div class="text-sub-header">
          <h2 class="section-header">
            <%= reportData?.head?.head_name %> (વર્ષ : <%= reportData?.financialYear?.financial_tag %>)
          </h2>
        </div>
        <ul class="details-list">
          <li class="info-section">
            <div class="info-item">
              <span>એસ.એમ.સી.:</span>
              <b class="cs-semi_bold cs-primary_color"><%= reportData?.userDetails?.school_name %></b>
            </div>
            <div class="info-item">
              <span>ક્લસ્ટર:</span>
              <b class="cs-semi_bold cs-primary_color"><%= reportData?.userDetails?.cluster_name %></b>
            </div>
            <div class="info-item">
              <span>શાળાનો ડાયસ કોડ:</span>
              <b class="cs-semi_bold cs-primary_color"><%= reportData?.userDetails?.school_dice_code %></b>
            </div>
          </li>
          <li class="info-section">
            <div class="info-item">
              <span>જીલ્લો:</span>
              <b class="cs-semi_bold cs-primary_color"><%= reportData?.userDetails?.sub_division %></b>
            </div>
            <div class="info-item">
              <span>તાલુકો:</span>
              <b class="cs-semi_bold cs-primary_color"><%= reportData?.userDetails?.district %></b>
            </div>
            <div class="info-item">
              <span>વર્ષ:</span>
              <b class="cs-semi_bold cs-primary_color"><%= reportData?.financialYear?.financial_tag %></b>
            </div>
          </li>
        </ul>
        <div class="row">
          <div class="col-md-6">
            <table class="table">
              <tr>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit"
                >
                  જમા સરવૈયુ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit"
                >
                  રોકડ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit"
                >
                  બેંક
                </th>
              </tr>
              <tr>
                <td class="merged-table-td">ગત વર્ષ ની જમા ગ્રાન્ટ ની રકમ</td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.cashOpeningBalance %></td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.bankOpeningBalance %></td>
              </tr>
              <tr>
                <td class="merged-table-td">ચાલુ વર્ષની ગ્રાન્ટ ની રકમ</td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.totalCashCreditAmount %></td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.totalBankCreditAmount %></td>
              </tr>
              <tr>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit"
                >
                  કુલ જમા રકમ
                </th>
                <td
                  colspan="2"
                  class="cs-semi_bold cs-primary_color merged-table-td tr-credit"
                >
                <%= reportData?.khatavahiResultData?.totalAmount %>
                </td>
              </tr>
            </table>
          </div>

          <div class="col-md-6">
            <table class="table">
              <tr>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit"
                >
                  ઉધાર સરવૈયુ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit"
                >
                  રોકડ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit"
                >
                  બેંક
                </th>
              </tr>
              <tr>
                <td class="merged-table-td">ખર્ચ</td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.totalCashDebitAmount %></td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.totalBankDebitAmount %></td>
              </tr>
              <tr>
                <th class="cs-semi_bold cs-primary_color merged-table-th tr-debit">
                  કુલ ખર્ચ
                </th>
                <td colspan="2" class="cs-semi_bold cs-primary_color merged-table-td tr-debit"><%= reportData?.khatavahiResultData?.totalExpense %></td>
              </tr>
              <tr>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-bg-gray"
                >
                  કુલ સિલક રકમ
                </th>
                <td
                  colspan="2"
                  class="cs-semi_bold cs-primary_color merged-table-td tr-bg-gray"
                >
                <%= reportData?.khatavahiResultData?.totalClosingAmount %>
                </td>
              </tr>
            </table>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <table class="table">
              <tr>
                <th
                  colspan="5"
                  class="cs-semi_bold cs-primary_color merged-cell merged-table-th tr-thead-credit"
                >
                  જમા
                </th>
              </tr>
              <tr>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit" style="width: 5%;"
                >
                  ક્રમ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit" style="width: 18%;"
                >
                  તારીખ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit" style="width: 37%;"
                >
                  વિગત
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit" style="width: 20%;"
                >
                  રોકડ જમા
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-credit" style="width: 20%;"
                >
                  બેંક ખાતે જમા
                </th>
              </tr>
              <tr>
                <td class="merged-table-td"></td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.financialYearStartDate %></td>
                <td class="merged-table-td">શ્રી ખુલતી સિલક</td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.cashOpeningBalance %></td>
                <td class="merged-table-td"><%= reportData?.khatavahiResultData?.bankOpeningBalance %></td>
              </tr>
              <% reportData?.khatavahiResultData?.creditTransactions?.forEach((data, index) => { %>
                <tr>
                  <td class="merged-table-td"><%= index + 1 %></td>
                  <td class="merged-table-td"><%= data.transaction_date %></td>
                  <td class="merged-table-td"><%= data.details %></td>
                  <td class="merged-table-td"><%= data.cash_amount %></td>
                  <td class="merged-table-td"><%= data.bank_amount %></td>
                </tr>
              <% }); %>
            </table>
          </div>

          <div class="col-md-6">
            <table class="table">
              <tr>
                <th
                  colspan="6"
                  class="cs-semi_bold cs-primary_color merged-cell merged-table-th tr-thead-debit"
                >
                  ખર્ચ
                </th>
              </tr>
              <tr>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit" style="width: 5%;"
                >
                  ક્રમ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit" style="width: 18%;"
                >
                  તારીખ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit" style="width: 38%;"
                >
                  વિગત
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit" style="width: 17%;"
                >
                  રોકડ ખર્ચ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit" style="width: 17%;"
                >
                  બેંક ખાતે ખર્ચ
                </th>
                <th
                  class="cs-semi_bold cs-primary_color merged-table-th tr-debit" style="width: 5%;"
                >
                  વા.નં.
                </th>
              </tr>
              <tr class="blank-tr-h30">
                <td class="merged-table-td"></td>
                <td class="merged-table-td"></td>
                <td class="merged-table-td"></td>
                <td class="merged-table-td"></td>
                <td class="merged-table-td"></td>
                <td class="merged-table-td"></td>
              </tr>
              <% reportData?.khatavahiResultData?.debitTransactions?.forEach((data, index) => { %>
                <tr>
                  <td class="merged-table-td"><%= index + 1 %></td>
                  <td class="merged-table-td"><%= data.transaction_date %></td>
                  <td class="merged-table-td"><%= data.details %></td>
                  <td class="merged-table-td"><%= data.cash_amount %></td>
                  <td class="merged-table-td"><%= data.bank_amount %></td>
                  <td class="merged-table-td"><%= index + 1 %></td>
                </tr>
              <% }); %>
            </table>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
