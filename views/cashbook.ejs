<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>કેસ બુક (જમા)</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: sans-serif;
        background-color: #f5f7ff; /* Light blue background */
        color: #777777;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        font-weight: 400;
      }

      .main-container {
        background-color: #fff;
        padding: 35px;
        /* border-radius: 5px; */
        /* box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); */
        margin-top: 50%;
        margin-bottom: 50%;
        width: 100%;
        height: 100%;
      }

      .section-header {
        text-align: center;
        color: #111111;
        margin-bottom: 25px;
        font-weight: 600;
        font-size: 22px;
        line-height: 1.5em;
        border-top: 1px solid #eaeaea;
        border-bottom: 1px solid #eaeaea;
        padding: 10px 0;
      }

      .cs-f28 {
        font-size: 28px;
      }

      .cs-f45 {
        font-size: 45px;
      }

      .cs-f25 {
        font-size: 25px;
      }

      .cs-m0 {
        margin: 0px !important;
      }

      .cs-dip_blue_color {
        color: #2525cf;
      }

      .cs-bold {
        font-weight: 700;
      }

      .secondary-text {
        font-size: 25px;
        color: #777777;
        margin: 0px !important;
        line-height: 1.5em;
      }
      .text-header {
        text-align: center;
        margin-bottom: 25px;
      }

      .cs-primary_color {
        color: #111111;
      }
      .cs-semi_bold {
        font-weight: 600;
      }

      @media print {
        @page {
          size: A4 portrait;
          margin: 0; /* Remove margins */
        }
        body {
          background-color: #fff !important;
        }
        .main-container {
          width: 100%;
          padding: 20px; /* Adjust padding */
        }
      }
    </style>
  </head>
  <body>
    <div class="main-container">
      <div class="text-header">
        <h1
          class="text-center cs-f45 cs-m0 cs-bold cs-dip_blue_color text-transform-uppercase"
        >
        રોજમેળ
        </h1>
        <p class="text-center secondary-text">
            એસ.એમ.સી. (<%= reportData?.userDetails?.school_name %>)
        </p>
      </div>
      <div class="text-sub-header">
        <h2 class="section-header">
          <p>વર્ષ : <%= reportData?.financialYear?.financial_tag %></p>
          <p><span><%= reportData?.cashbookResultData?.yearStartDate %> થી <span><%= reportData?.cashbookResultData?.yearEndDate %></span></p>
        </h2>
      </div>
    </div>
  </body>
</html>