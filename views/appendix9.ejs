<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Meta Tags -->
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="easyrojmel" />
    <title>પરિશિષ્ટ - ૯</title>
    <!-- Google Font (Fallback if system fonts are missing) -->
    <!-- <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Gujarati:wght@400;700&display=swap" rel="stylesheet"> -->
    <style>
      /* body {
        font-family: "Noto Sans Gujarati", "Lohit Gujarati", "Samyak Gujarati", "Gujarati MT", sans-serif;
      } */
      .cs-heading.cs-style1 {
          text-align: center;
      }
      @media print {
        .cs-ml15.cs-signature {
          margin-top: 110px;
          text-align: end;
        }
        .signature-img {
          margin-top: 105px;
          width: 155.956px;
          border-bottom: 1px solid #000;
          float: right;
        }
      }
    </style>
  </head>

  <body>
    <div class="cs-container">
      <div class="cs-report cs-style1">
        <div class="cs-report_in" id="download_section">
          <div class="cs-text_center cs-mb25">
            <p class="cs-f28 cs-m0 cs-bold cs-dip_blue_color text-transform-uppercase">
              પરિશિષ્ટ - ૯
            </p>
            <p class="cs-m0 cs-f15 cs-secondary_color">
                <%= reportData?.userDetails?.rojmel_name %> (<%= reportData?.userDetails?.bank_account_no %> - <%= reportData?.userDetails?.bank_name %>)
            </p>
          </div>
          <div class="cs-heading cs-style1 cs-f18 cs-primary_color cs-mb25 cs-semi_bold">બેંક સાથે મેળવણુ - બેંક રિકન્સીએશન (પરિશિષ્ટ-૯, પેરા નં.૨, ક્રમાંક–૧૨)</div>
          <ul class="cs-list cs-style2 cs-focus_bg">
            <li>
              <div class="cs-list_left">એસ.એમ.સી.: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.school_name %></b></div>
              <div class="cs-list_right">ક્લસ્ટર: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.cluster_name %></b></div>
            </li>
            <li>
              <div class="cs-list_left">શાળાનો ડાયસ કોડ: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.school_dice_code %></b></div>
              <div class="cs-list_right">જીલ્લો: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.sub_division %></b></div>
            </li>
            <li>
              <div class="cs-list_left">તાલુકો: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.district %></b></div>
              <div class="cs-list_right">વર્ષ: <b class="cs-primary_color cs-semi_bold "><%= reportData?.financialYear?.financial_tag %></b></div>
            </li>
          </ul>
          <div class="cs-table cs-style2">
            <div>
              <div class="cs-table_responsive">
                <table>
                  <thead>
                    <tr class="cs-focus_bg">
                      <th class="cs-width_0_5 cs-semi_bold cs-primary_color">
                      </th>
                      <th class="cs-width_3 cs-semi_bold cs-primary_color">
                        વિગત
                      </th>
                      <th class="cs-width_1 cs-semi_bold cs-primary_color">
                        રોકડ રકમ
                      </th>
                      <th class="cs-width_1 cs-semi_bold cs-primary_color">
                        બેંક રકમ
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>(+)</td>
                      <td>રોજમેળ પ્રમાણે તા:-૩૧/૦૩/૨૦૨૨ ની અંતિમ રોજમેળ સિલક ઉમેરવી</td>
                      <td><%= reportData?.appendix9ResultData?.totalCashAmount %></td>
                      <td><%= reportData?.appendix9ResultData?.totalBankAmount %></td>
                    </tr>
                    <tr>
                      <td>(+)</td>
                      <td>ઉમેરો - ચેક ઇસ્યુ થયા હોય પણ વટાવેલ ન હોય</td>
                      <td>0</td>
                      <td>0</td>
                    </tr>
                    <tr>
                      <td></td>
                      <td>બેંકમાં જમા નોંધ થઈ હોય પરંતુ રોજમેળમાં દર્શાવ્યા ન હોય</td>
                      <td>0</td>
                      <td>0</td>
                    </tr>
                    <tr class="cs-focus_bg">
                      <td colspan="2" class="cs-text_center cs-semi_bold cs-primary_color">કુલ</td>
                      <td class="cs-semi_bold cs-primary_color"><%= reportData?.appendix9ResultData?.totalCashAmount %></td>
                      <td class="cs-semi_bold cs-primary_color"><%= reportData?.appendix9ResultData?.totalBankAmount %></td>
                    </tr>
                    <tr>
                      <td>(-)</td>
                      <td>બાદ:- બેંકમાં મોકલવામાં આવેલી રોકડ કે ચેક બેંક ખાતામાં જમા ન થઈ હોય</td>
                      <td>0</td>
                      <td>0</td>
                    </tr>
                    <tr>
                      <td></td>
                      <td>બેંક ખાતામાં ઉધારવામાં આવેલ ચાર્જિસ પરંતુ તે રોજમેળમાં ઉલ્લેખ થયેલ ન</td>
                      <td>0</td>
                      <td>0</td>
                    </tr>
                    <tr>
                      <td colspan="2" class="cs-text_center cs-semi_bold cs-primary_color">કુલ</td>
                      <td class="cs-semi_bold cs-primary_color"></td>
                      <td class="cs-semi_bold cs-primary_color"></td>
                    </tr>
                    <tr class="cs-focus_bg">
                      <td colspan="2" class="cs-text_center cs-semi_bold cs-primary_color">પાસબુક/બેક સ્ટેટમેન્ટ પ્રમાણે સિલક</td>
                      <td colspan="2" class="cs-text_center cs-semi_bold cs-primary_color"><%= reportData?.appendix9ResultData?.totalAmount %></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div class="signature-img"></div>
        <div class="cs-ml15 cs-signature">
          <p>આચાર્યશ્રી ની સહી અને સિકકો</p>
        </div>
      </div>
    </div>
  </body>
</html>