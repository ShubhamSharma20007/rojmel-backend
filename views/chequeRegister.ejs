<!DOCTYPE html>
<html class="no-js" lang="en">
  <head>
    <!-- Meta Tags -->
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="easyrojmel" />
    <title>ચેક રજીસ્ટર</title>
    <style>
      .cs-heading.cs-style1 {
        text-align: center;
      }
      .cs-table.cs-style2 td, .cs-table.cs-style2 th {
          padding: 10px;
      }
      table {
        font-size: 11px;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="cs-container">
      <div class="cs-report cs-style1">
        <div class="cs-report_in" id="download_section">
          <div class="cs-text_center cs-mb25">
            <p
              class="cs-f28 cs-m0 cs-bold cs-dip_blue_color text-transform-uppercase"
            >
              ચેક રજીસ્ટર
            </p>
            <p class="cs-m0 cs-f15 cs-secondary_color">
              <%= reportData?.userDetails?.rojmel_name %> (<%= reportData?.userDetails?.bank_account_no %> - <%= reportData?.userDetails?.bank_name %>)
            </p>
          </div>
          <div
            class="cs-heading cs-style1 cs-f18 cs-primary_color cs-mb25 cs-semi_bold"
          >
            ચેક રજીસ્ટર પત્રક (પરિશિષ્ટ- ૪) વર્ષ : <%= reportData?.financialYear?.financial_tag %>
          </div>
          <ul class="cs-list cs-style2 cs-focus_bg">
            <li>
              <div class="cs-list_left">એસ.એમ.સી.: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.school_name %></b></div>
              <div class="cs-list_right">ક્લસ્ટર: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.cluster_name %></b></div>
            </li>
            <li>
              <div class="cs-list_left">શાળાનો ડાયસ કોડ: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.school_dice_code %></b></div>
              <div class="cs-list_right">જીલ્લો: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.sub_division %></b></div>
            </li>
            <li>
              <div class="cs-list_left">તાલુકો: <b class="cs-primary_color cs-semi_bold "><%= reportData?.userDetails?.district %></b></div>
              <div class="cs-list_right">વર્ષ: <b class="cs-primary_color cs-semi_bold "><%= reportData?.financialYear?.financial_tag %></b></div>
            </li>
          </ul>
          <div class="cs-table cs-style2 cs-f12">
            <div class="cs-round_border">
              <div class="cs-table_responsive">
                <table>
                  <thead>
                    <tr class="cs-thead2-tr-receive">
                      <th class="cs-width_0_5 cs-semi_bold cs-primary_color cs-text_center">
                        ક્રમ
                      </th>
                      <th
                        class="cs-width_1 cs-semi_bold cs-primary_color cs-text_center"
                      >
                        તારીખ
                      </th>
                      <th class="cs-width_0_5 cs-semi_bold cs-primary_color cs-text_center">
                        વા.નં
                      </th>
                      <th class="cs-width_2 cs-semi_bold cs-primary_color cs-text_center">
                        જેની તરફેણમાં ચેક લખ્યો હોય તેની વિગત
                      </th>
                      <th class="cs-width_1 cs-semi_bold cs-primary_color cs-text_center">
                        ચેકની રકમ
                      </th>
                      <th class="cs-width_1_5 cs-semi_bold cs-primary_color cs-text_center">
                        હેડ
                      </th>
                      <th class="cs-width_1 cs-semi_bold cs-primary_color cs-text_center">
                        ચેક/PFMS ક્રમાંક
                      </th>
                      <th class="cs-width_1 cs-semi_bold cs-primary_color cs-text_center">
                        ચેક/PFMS વટાવ્યા તારીખ
                      </th>
                      <th class="cs-width_1 cs-semi_bold cs-primary_color cs-text_center">
                        મંજુર કરનારની સહી
                      </th>
                      <th class="cs-width_0_5 cs-semi_bold cs-primary_color cs-text_center">
                        શેરો
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <% reportData.chequeRegisterData.forEach((data, index) => { %>
                      <tr>
                        <td class="cs-text_center"><%= index + 1 %></td>
                        <td class="cs-text_center"><%= data.transaction_date %></td>
                        <td class="cs-text_center"><%= index + 1 %></td>
                        <td class="cs-text_center"><%= data.details %></td>
                        <td class="cs-text_center"><%= data.amount %></td>
                        <td class="cs-text_center"><%= data.head_name %></td>
                        <td class="cs-text_center"><%= data.cheque_number %></td>
                        <td class="cs-text_center"><%= data.cheque_pfms_clearing_date ? data.cheque_pfms_clearing_date : '' %></td>
                        <td class="cs-text_center"></td>
                        <td class="cs-text_center">-</td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>